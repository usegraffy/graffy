{
  "name": "graffy-project",
  "version": "0.18.0",
  "description": "Graffy Project",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aravindet/graffy.git"
  },
  "scripts": {
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "lint": "biome ci .",
    "typecheck": "tsc",
    "package": "./scripts/package.js",
    "start": "node --strip-types src/example/server.ts",
    "test": "npm run test:node && npm run test:react",
    "test:node": "NODE_ENV=testing node --strip-types --test --experimental-test-module-mocks --test-concurrency=1 --import ./scripts/node-test-setup.js $(find src -name '*.test.ts' -not -path '*/react/*')",
    "test:react": "NODE_ENV=testing node --strip-types --test --experimental-test-module-mocks --import ./scripts/node-test-setup.js --import ./scripts/jsdom-setup.js src/react/react.test.ts",
    "pg:clean": "docker rm -f graffypg",
    "pg:psql": "docker run --name pgrepl -e POSTGRES_PASSWORD=graffy -d postgres:alpine && until docker exec -it pgrepl psql -U postgres; do sleep 0.5; done ; docker rm -f pgrepl",
    "ch:clean": "docker compose -f src/clickhouse/test/docker-compose.yml down -v --remove-orphans",
    "ch:up": "docker compose -f src/clickhouse/test/docker-compose.yml up -d"
  },
  "workspaces": [
    "src/*"
  ],
  "author": "aravindet",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/aravindet/graffy/issues"
  },
  "homepage": "https://graffy.org",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@clickhouse/client": "^1.18.5",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/debug": "^4.1.13",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.2",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "merge-async-iterators": "^0.2.1",
    "nanoid": "^5.1.11",
    "p-map": "^7.0.4",
    "pg": "^8.20.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-test-renderer": "^19.2.6",
    "rimraf": "^6.1.3",
    "sql-formatter": "^15.7.4",
    "sql-template-tag": "^5.2.1",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "vite": "^8.0.13",
    "ws": "^8.20.1",
    "yargs": "^18.0.0"
  },
  "peerDependencies": {
    "@clickhouse/client": "^1.17.0",
    "pg": "^8.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
